{
  "manifest_version": 3,
  "name": "Lichess Arrow Colors",
  "version": "1.8.1",
  "description": "Shades lichess.org engine suggestion arrows green to red by how good each move is.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "src/logic.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
